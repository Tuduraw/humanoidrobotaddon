    "main": [ "com.example.humanoidrobotaddon.HumanoidRobotAddon" ],
    "client": [ "com.example.humanoidrobotaddon.client.HumanoidRobotAddonClient" ]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "minecraft": "1.21.11",
    "java": ">=21",
    "tudursvehiclemod": ">=1.0.0"
  },
  "mixins": [
    {
      "config": "humanoidrobotaddon.client.mixins.json",
      "environment": "client"
    }
  ]
